{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alton-landing",
  "main": ".open-next/worker.js",
  "pages_build_output_dir": ".open-next/worker",
  "compatibility_date": "2026-04-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
